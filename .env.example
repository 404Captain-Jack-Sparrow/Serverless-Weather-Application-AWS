# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# AWS SNS Topic ARN
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:lambdaTopic

# Target City (defaults to Jhansi if not specified)
CITY=Jhansi

# AWS Region (optional, defaults to your AWS CLI configuration)
AWS_DEFAULT_REGION=us-east-1
